<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MailBridge</AssemblyName>
    <RootNamespace>MailBridge</RootNamespace>
    <Description>Read-only IMAP access exposed as an MCP server over stdio.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MailBridge.Tests" />
  </ItemGroup>

</Project>
